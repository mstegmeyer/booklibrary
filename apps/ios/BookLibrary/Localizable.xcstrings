        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit deiner Bibliothek verbinden" } }
      }
    },
    "Enter the address of the server that hosts your library." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib die Adresse des Servers ein, auf dem deine Bibliothek läuft." } }
      }
    },
    "Enter the address of your server, for example books.example.net." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib die Adresse deines Servers ein, zum Beispiel books.example.net." } }
