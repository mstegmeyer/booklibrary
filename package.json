{
  "name": "book-library",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @book-library/server --filter @book-library/web dev",
    "build": "pnpm --recursive build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "e2e": "pnpm build && pnpm --filter @book-library/e2e e2e",
    "db:generate": "pnpm --filter @book-library/server db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2"
  }
}
